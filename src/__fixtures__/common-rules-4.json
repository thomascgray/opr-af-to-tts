    {
      "id": "T08VkBuVmNZ_",
      "name": "Hero",
      "description": "Heroes with up to Tough(6) may deploy as part of one multi-model unit without another Hero, but must use the unit’s Defense until all other models have been killed. The Hero’s unit, and units within 6” of friendly Heroes with Tough(9) or higher, may use the Hero’s Quality for Morale Tests as long as the Hero isn’t Shaken.",
      "enabledGameSystems": [
        2,
