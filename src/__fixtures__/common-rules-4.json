{
  "rules": [
    {
      "id": "3FeiOe3krHMa",
      "name": "Aircraft",
      "description": "May only use Advance actions, moving in a straight line, and adding 30” to its total move (even if Shaken). Aircraft ignore all units and terrain when moving and stopping, can’t seize or contest objectives, can’t be charged, and units targeting them get -12” range and -1 to hit rolls.",
      "enabledGameSystems": null,
      "coreType": 1,
      "displayCoreRuleForSystem": false
    },
    {
      "id": "6mJw5IdqSqNC",
      "name": "Ambush",
      "description": "May be set aside before deployment. At the start of any round after the first, may be deployed anywhere over 9” away from enemy units. Players alternate in placing Ambush units, starting with the player that activates next. Units that deploy via Ambush can’t seize or contest objectives on the round they deploy.",
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6
      ],
      "coreType": 1,
      "displayCoreRuleForSystem": true
    },
    {
      "id": "17crjK7P6_w6",
      "name": "AP",
      "description": "Targets get -X to Defense rolls when blocking hits.",
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6
      ],
      "coreType": 1,
      "displayCoreRuleForSystem": true
    },
    {
      "id": "GRuFoZiyjY5f",
      "name": "Artillery",
      "description": "When this model uses Hold actions and shoots at enemies over 12” away, it gets +1 to hit rolls. If most models in this unit have this rule, as long as they haven't moved during this round, enemy units shooting at them from over 12” away get -1 to hit rolls.",
      "enabledGameSystems": [],
      "coreType": 1,
      "displayCoreRuleForSystem": false
    },
    {
      "id": "FF5ddXgx75lI",
      "name": "Assault",
      "description": "Counts as both a ranged weapon and a melee weapon.",
      "enabledGameSystems": [],
      "coreType": 1,
      "displayCoreRuleForSystem": false
    },
    {
      "id": "Naqc5mga9Uha",
      "name": "Bane",
      "description": "Ignores Regeneration, and when attacking, the target must re-roll unmodified Defense results of 6.",
      "enabledGameSystems": [],
      "coreType": 1,
      "displayCoreRuleForSystem": false
    },
    {
      "id": "ywXKQKPOLjTF",
      "name": "Banner",
      "description": "This model and its unit get +1 to Morale Test rolls triggered by shooting/melee.",
      "enabledGameSystems": [],
      "coreType": 1,
      "displayCoreRuleForSystem": false
    },
    {
      "id": "w_vX0mi58KKt",
      "name": "Blast",
      "description": "Ignores Cover, and after resolving other special rules, each hit is multiplied by X, where X is up to as many hits as models in the target unit.",
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6
      ],
      "coreType": 1,
      "displayCoreRuleForSystem": true
    },
    {
      "id": "0bcGY4Xr4NE0",
      "name": "Brace",
      "description": "Enemies charging this unit get -X total Impact rolls, unless this unit is Fatigued.",
      "enabledGameSystems": [],
      "coreType": 1,
      "displayCoreRuleForSystem": false
    },
    {
      "id": "47CAqf7ySlfc",
      "name": "Caster",
      "description": "Gets X spell tokens at the start of each round, but can’t have more than 6 at once. Once per activation, before attacking, spend as many tokens as the spell’s value to try casting one or more spells (only one try per spell). Pick a target and roll one die, and on 4+ resolve the spell’s effect. Models within 18” of the Caster may spend any number of spell tokens at the same time before rolling to give the Caster +1/-1 to the roll per token.",
      "enabledGameSystems": null,
      "coreType": 1,
      "displayCoreRuleForSystem": false
    },
    {
      "id": "c45Fw0D2oGOk",
      "name": "Counter",
      "description": "May strike first with this weapon when charged, unless this unit is Fatigued.",
      "enabledGameSystems": [
        4,
        5,
        6
      ],
      "coreType": 1,
      "displayCoreRuleForSystem": true
    },
    {
      "id": "_mrPya5SXSqW",
      "name": "Deadly",
      "description": "Assign each wound to one model, and multiply it by X. Hits from Deadly must be resolved first, and these wounds don’t carry over to other models if the original target is killed.",
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6
      ],
      "coreType": 1,
      "displayCoreRuleForSystem": true
    },
    {
      "id": "KdgwlPb8LuD2",
      "name": "Fast",
      "description": "Moves +2” when using Advance, and +4” when using Rush/Charge.",
      "enabledGameSystems": [
        2,
