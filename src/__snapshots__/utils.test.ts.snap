  "coreSpecialRulesDict": [
    {
      "coreType": 1,
      "description": "May only use Advance actions, moving in a straight line, and adding 30” to its total move (even if Shaken). Aircraft ignore all units and terrain when moving and stopping, can’t seize or contest objectives, can’t be charged, and units targeting them get -12” range and -1 to hit rolls.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": null,
      "id": "3FeiOe3krHMa",
      "name": "Aircraft",
    },
    {
      "coreType": 1,
      "description": "May be set aside before deployment. At the start of any round after the first, may be deployed anywhere over 9” away from enemy units. Players alternate in placing Ambush units, starting with the player that activates next. Units that deploy via Ambush can’t seize or contest objectives on the round they deploy.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "6mJw5IdqSqNC",
      "name": "Ambush",
    },
    {
      "coreType": 1,
      "description": "Targets get -X to Defense rolls when blocking hits.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "17crjK7P6_w6",
      "name": "AP",
    },
    {
      "coreType": 1,
      "description": "When this model uses Hold actions and shoots at enemies over 12” away, it gets +1 to hit rolls. If most models in this unit have this rule, as long as they haven't moved during this round, enemy units shooting at them from over 12” away get -1 to hit rolls.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "GRuFoZiyjY5f",
      "name": "Artillery",
    },
    {
      "coreType": 1,
      "description": "Counts as both a ranged weapon and a melee weapon.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "FF5ddXgx75lI",
      "name": "Assault",
    },
    {
      "coreType": 1,
      "description": "Ignores Regeneration, and when attacking, the target must re-roll unmodified Defense results of 6.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "Naqc5mga9Uha",
      "name": "Bane",
    },
    {
      "coreType": 1,
      "description": "This model and its unit get +1 to Morale Test rolls triggered by shooting/melee.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "ywXKQKPOLjTF",
      "name": "Banner",
    },
    {
      "coreType": 1,
      "description": "Ignores Cover, and after resolving other special rules, each hit is multiplied by X, where X is up to as many hits as models in the target unit.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "w_vX0mi58KKt",
      "name": "Blast",
    },
    {
      "coreType": 1,
      "description": "Enemies charging this unit get -X total Impact rolls, unless this unit is Fatigued.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "0bcGY4Xr4NE0",
      "name": "Brace",
    },
    {
      "coreType": 1,
      "description": "Gets X spell tokens at the start of each round, but can’t have more than 6 at once. Once per activation, before attacking, spend as many tokens as the spell’s value to try casting one or more spells (only one try per spell). Pick a target and roll one die, and on 4+ resolve the spell’s effect. Models within 18” of the Caster may spend any number of spell tokens at the same time before rolling to give the Caster +1/-1 to the roll per token.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": null,
      "id": "47CAqf7ySlfc",
      "name": "Caster",
    },
    {
      "coreType": 1,
      "description": "May strike first with this weapon when charged, unless this unit is Fatigued.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [
        4,
        5,
        6,
      ],
      "id": "c45Fw0D2oGOk",
      "name": "Counter",
    },
    {
      "coreType": 1,
      "description": "Assign each wound to one model, and multiply it by X. Hits from Deadly must be resolved first, and these wounds don’t carry over to other models if the original target is killed.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "_mrPya5SXSqW",
      "name": "Deadly",
    },
    {
      "coreType": 1,
      "description": "Moves +2” when using Advance, and +4” when using Rush/Charge.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "KdgwlPb8LuD2",
      "name": "Fast",
    },
    {
      "coreType": 1,
      "description": "When in melee with this model, enemies count as having taken +X wounds when checking who won.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "dIQ3SGl2J2Ew",
      "name": "Fear",
    },
    {
      "coreType": 1,
      "description": "When a unit where most models have this rule fails a Morale Test, roll one die. On a 4+ it counts as passed instead.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "2atvlmICQSCV",
      "name": "Fearless",
    },
    {
      "coreType": 1,
      "description": "May move through units and terrain, and ignores the effects of Difficult and Dangerous terrain.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "-QJdqJEKjIpE",
      "name": "Flying",
    },
    {
      "coreType": 1,
      "description": "When charging, unmodified result of 6 to hit deal 1 extra hit (only the original hit counts as a 6 for special rules).",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "JoOCVPx1xT1G",
      "name": "Furious",
    },
    {
      "coreType": 1,
      "description": "Heroes with up to Tough(6) may deploy as part of one multi-model unit without another Hero, but must use the unit’s Defense until all other models have been killed. The Hero’s unit, and units within 6” of friendly Heroes with Tough(9) or higher, may use the Hero’s Quality for Morale Tests as long as the Hero isn’t Shaken.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "T08VkBuVmNZ_",
      "name": "Hero",
    },
    {
      "coreType": 1,
      "description": "May only use Hold actions.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "HWtnPV9LQF1D",
      "name": "Immobile",
    },
    {
      "coreType": 1,
      "description": "When charging, before either unit attacks, roll X dice, unless this unit is Fatigued. For each 2+ the target takes 1 hit.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "62-mYKVM9MLd",
      "name": "Impact",
    },
    {
      "coreType": 1,
      "description": "When using Hold actions and shooting, may target enemies that are not in line of sight as if in line of sight, and ignores Cover from Sight Blockers.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "8Ck9GAwUK824",
      "name": "Indirect",
    },
    {
      "coreType": 1,
      "description": "May only be used once per game.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": null,
      "id": "9042COVrLCsI",
      "name": "Limited",
    },
    {
      "coreType": 1,
      "description": "This model and its unit moves +1\\" when using move actions.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "qrG_DXJez5Dg",
      "name": "Musician",
    },
    {
      "coreType": 1,
      "description": "When this unit takes hits in melee, roll X dice per model with this rule in it, up to as many dice as hits taken. For each 6+ one hit is ignored (defender picks which).",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "_T07iXWo4VwJ",
      "name": "Parry",
    },
    {
      "coreType": 1,
      "description": "When a unit where most models have this rule takes wounds, roll one die for each. On a 5+ it is ignored.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "8KujvrTG8k9p",
      "name": "Regeneration",
    },
    {
      "coreType": 1,
      "description": "When this model shoots at enemies over 9” away, unmodified result of 6 to hit deal 1 extra hit (only the original hit counts as a 6 for special rules).",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
      ],
      "id": "H9E9PIWpGRdw",
      "name": "Relentless",
    },
    {
      "coreType": 1,
      "description": "Attacks at Quality 2+.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": null,
      "id": "Zx4mWN0SbmK8",
      "name": "Reliable",
    },
    {
      "coreType": 1,
      "description": "Ignores Regeneration, and for each unmodified result of 6 to hit, those hits get AP(+4).",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "cavWDboL4ubs",
      "name": "Rending",
    },
    {
      "coreType": 1,
      "description": "May be set aside before deployment. After all other units are deployed, may be deployed anywhere fully within 9” of their deployment zone, over 9” away from non-Scout enemy units. Players alternate in placing Scout units, starting with the player that activates next.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "FAMbscK5vhSu",
      "name": "Scout",
    },
    {
      "coreType": 1,
      "description": "For each unmodified result of 1 to block hits, this weapon deals 1 extra wound.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "IEJp3a4vE0CB",
      "name": "Shred",
    },
    {
      "coreType": 1,
      "description": "Moves -2” when using Advance, and -4” when using Rush/Charge.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
        9,
        10,
        7,
        8,
      ],
      "id": "Ldhtmr4H8b6G",
      "name": "Slow",
    },
    {
      "coreType": 1,
      "description": "Gets +1 to casting rolls.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "4Q1owB6yNFz1",
      "name": "Spell Amplifier",
    },
    {
      "coreType": 1,
      "description": "When units where most models have this rule are shot from over 9\\" away, enemy units get -1 to hit rolls.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "9jyvRoBODD-O",
      "name": "Stealth",
    },
    {
      "coreType": 1,
      "description": "May ignore the effects of Difficult terrain.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "JSKVyurtWIyW",
      "name": "Strider",
    },
    {
      "coreType": 1,
      "description": "For each unmodified result of 6 to hit, this weapon deals 1 extra hit (only the original hit counts as a 6 for special rules).",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "5v6oaGfrdf29",
      "name": "Surge",
    },
    {
      "coreType": 1,
      "description": "This model may pick any model in the target unit as its individual target for this weapon's attacks, which is resolved as if it was a unit of [1]. Takedown attacks must be resolved before other weapons.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "8Hjy54TYtwb7",
      "name": "Takedown",
    },
    {
      "coreType": 1,
      "description": "When charging, gets +1 to hit rolls and AP(+1) in melee.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": null,
      "id": "umbiz4tnEyF8",
      "name": "Thrust",
    },
    {
      "coreType": 1,
      "description": "This model must take X wounds before being killed. If a model with Tough joins a unit without it, then it is removed last when the unit takes wounds. You must continue to put wounds on the Tough model with most wounds in the unit until it is killed, before starting to put them on the next Tough model (Heroes must be assigned wounds last, even if already wounded).",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "a0YtInGiUDd6",
      "name": "Tough",
    },
    {
      "coreType": 1,
      "description": "May transport up to X friendly models or Heroes with up to Tough(6), and non-Heroes with up to Tough(3) which occupy 3 spaces each. Transports may deploy with units inside, and units may enter/exit by using any move action, getting within 2” to enter, and staying fully within 6” when exiting. Units inside/outside transports may not target other units that are outside/inside, but may target the transport itself. When a transport is destroyed, units inside must take a Dangerous Terrain Test, are Shaken, and must be placed fully within 6” of the transport before it’s removed.",
      "displayCoreRuleForSystem": true,
      "enabledGameSystems": [
        2,
        3,
      ],
      "id": "aogQZcOOQrDI",
      "name": "Transport",
    },
  ],
