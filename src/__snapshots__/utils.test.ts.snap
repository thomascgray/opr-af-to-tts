      "showWhenReferenced": false,
      "targetType": 2,
    },
    {
      "aliasedRuleId": null,
      "coreType": null,
      "description": "If this model is killed in melee, the attacking unit takes X hits. If this model survives melee, after both sides have finished attacking, it is immediately killed, and the enemy unit takes X hits.",
      "hasRating": true,
      "id": "F_1wfmpAyYwT",
      "name": "Self-Destruct",
      "showWhenReferenced": true,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": null,
      "description": "When a unit where most models have this rule takes wounds, roll one die for each. If the wound was from a spell, then it is ignored on a 2+. If the wound was not from a spell, then it is ignored on a 6+ instead.",
      "hasRating": false,
      "id": "h-Cj1XrX00JE",
      "name": "Spell Resistance",
      "showWhenReferenced": true,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": null,
      "description": "May only use Hold or Advance actions, but can’t shoot when moving.",
      "hasRating": false,
      "id": "n8Uql4fyd5AX",
      "name": "Cumbersome",
      "showWhenReferenced": true,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": null,
      "description": "Once per game, during this model's activation, before attacking, pick X enemy units within 18\\" and in line of sight of it, and place one token on them. Friendly units get AP(+1) on their weapons when attacking them.",
      "hasRating": true,
      "id": "HMiVg3VVLQv3",
      "name": "Piercing Target",
      "showWhenReferenced": true,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": null,
      "description": "Once per activation, before attacking, pick one enemy unit within 18\\" in line of sight, which friendly units gets Unpredictable Fighter against once (next time the effect would apply).",
      "hasRating": false,
      "id": "Ajazu0ij2v5q",
      "name": "Unpredictable Fighter Mark",
      "showWhenReferenced": true,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": null,
      "description": "If most models in this unit have this rule, they get +1 to Morale Test rolls when shot/charged from over 9\\"/6\\" away.",
      "hasRating": false,
      "id": "LbpquFUyGSZ7",
      "name": "Valiant",
      "showWhenReferenced": true,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": null,
      "description": "If most models in this unit have Valiant, they always get +1 to Morale Test rolls from Valiant (instead of only when shot/charged from over 9\\"/6\\" away).",
      "hasRating": false,
      "id": "TbjUdR-OJZPw",
      "name": "Enhanced Valiant",
      "showWhenReferenced": true,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": 1,
      "description": "AP",
      "hasRating": true,
      "id": "CQes0mDvF4bV",
      "name": "AP",
      "showWhenReferenced": false,
      "targetType": 2,
    },
    {
      "aliasedRuleId": null,
      "coreType": 1,
      "description": "Gets X spell tokens at the start of each round, but can’t have more than 6 at once. Once per activation, before attacking, spend as many tokens as the spell’s value to try casting one or more spells (only one try per spell). Pick a target and roll one die, and on 4+ resolve the spell’s effect. Models within 18” of the Caster may spend any number of spell tokens at the same time before rolling to give the Caster +1/-1 to the roll per token.",
      "hasRating": true,
      "id": "47CAqf7ySlfc",
      "name": "Caster",
      "showWhenReferenced": false,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": 1,
      "description": "When charging, unmodified result of 6 to hit deal 1 extra hit (only the original hit counts as a 6 for special rules).",
      "hasRating": false,
      "id": "JoOCVPx1xT1G",
      "name": "Furious",
      "showWhenReferenced": false,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": 1,
      "description": "When a unit where most models have this rule takes wounds, roll one die for each. On a 5+ it is ignored.",
      "hasRating": false,
      "id": "8KujvrTG8k9p",
      "name": "Regeneration",
      "showWhenReferenced": false,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": 1,
      "description": "When units where most models have this rule are shot from over 9\\" away, enemy units get -1 to hit rolls.",
      "hasRating": false,
      "id": "9jyvRoBODD-O",
      "name": "Stealth",
      "showWhenReferenced": false,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": 1,
      "description": "Heroes with up to Tough(6) may deploy as part of one multi-model unit without another Hero, but must use the unit’s Defense until all other models have been killed. The Hero’s unit, and units within 6” of friendly Heroes with Tough(9) or higher, may use the Hero’s Quality for Morale Tests as long as the Hero isn’t Shaken.",
      "hasRating": false,
      "id": "T08VkBuVmNZ_",
      "name": "Hero",
      "showWhenReferenced": false,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": 1,
      "description": "This model may pick any model in the target unit as its individual target for this weapon's attacks, which is resolved as if it was a unit of [1]. Takedown attacks must be resolved before other weapons.",
      "hasRating": false,
      "id": "8Hjy54TYtwb7",
      "name": "Takedown",
      "showWhenReferenced": false,
      "targetType": 2,
    },
    {
      "aliasedRuleId": null,
      "coreType": 1,
      "description": "Assign each wound to one model, and multiply it by X. Hits from Deadly must be resolved first, and these wounds don’t carry over to other models if the original target is killed.",
      "hasRating": true,
      "id": "_mrPya5SXSqW",
      "name": "Deadly",
      "showWhenReferenced": false,
      "targetType": 2,
    },
    {
      "aliasedRuleId": null,
      "coreType": 5,
      "description": "This model gets +X to Defense rolls.",
      "hasRating": true,
      "id": "s6MgSfmgylXU",
      "name": "Defense",
      "showWhenReferenced": false,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": 1,
      "description": "May be set aside before deployment. At the start of any round after the first, may be deployed anywhere over 9” away from enemy units. Players alternate in placing Ambush units, starting with the player that activates next. Units that deploy via Ambush can’t seize or contest objectives on the round they deploy.",
      "hasRating": false,
      "id": "6mJw5IdqSqNC",
      "name": "Ambush",
      "showWhenReferenced": false,
      "targetType": 1,
    },
    {
      "aliasedRuleId": null,
      "coreType": null,
      "description": "When attacking, roll one die and apply one effect to all models with this rule: on a 1-3 they get AP(+1), and on a 4-6 they get +1 to hit rolls instead.",
      "hasRating": false,
      "id": "i40cKJoXJ7zm",
      "name": "Unpredictable",
      "showWhenReferenced": true,
      "targetType": 1,
    },
