    "name": "Pathfinder Sniper",
    "originalCasterValue": 0,
    "originalToughValue": 3,
    "selectionId": "Yl_bE",
    "ttsDescriptionOutput": "[fde047]Anti-Matter-Sniper Carbine[-]
