  "coreSpecialRulesDict": [
    {
      "coreType": 1,
      "description": "May only use Advance actions, moving in a straight line, and adding 30” to its total move (even if Shaken). Aircraft ignore all units and terrain when moving and stopping, can’t seize or contest objectives, can’t be charged, and units targeting them get -12” range and -1 to hit rolls.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": null,
      "id": "3FeiOe3krHMa",
      "name": "Aircraft",
    },
    {
      "coreType": 1,
      "description": "Only deploys D3 rounds afters its wave, and at the start of the round it's placed within 6” of a random AI Goal.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "6mJw5IdqSqNC",
      "name": "Ambush",
    },
    {
      "coreType": 1,
      "description": "Targets get -X to Defense rolls when blocking hits.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "17crjK7P6_w6",
      "name": "AP",
    },
    {
      "coreType": 1,
      "description": "When this model uses Hold actions and shoots at enemies over 12” away, it gets +1 to hit rolls. If most models in this unit have this rule, as long as they haven't moved during this round, enemy units shooting at them from over 12” away get -1 to hit rolls.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "GRuFoZiyjY5f",
      "name": "Artillery",
    },
    {
      "coreType": 1,
      "description": "Counts as both a ranged weapon and a melee weapon.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "FF5ddXgx75lI",
      "name": "Assault",
    },
    {
      "coreType": 1,
      "description": "Ignores Regeneration, and when attacking, the target must re-roll unmodified Defense results of 6.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "Naqc5mga9Uha",
      "name": "Bane",
    },
    {
      "coreType": 1,
      "description": "This model's unit and up to 2 nearest friendly units picked before the start of the game get +1 to Morale Test rolls triggered by shooting/melee. If this model is killed, picked models that are deployed lose the rule.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "ywXKQKPOLjTF",
      "name": "Banner",
    },
    {
      "coreType": 1,
      "description": "Ignores cover, and after resolving other special rules, each hit is multiplied by X, where X is up to as many hits as enemy models in the target unit and within 3” of it. Hits must be split evenly between all enemy units within 3” of any model from the target (players pick how).",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [
        2,
        3,
        4,
        5,
        6,
      ],
      "id": "w_vX0mi58KKt",
      "name": "Blast",
    },
    {
      "coreType": 1,
      "description": "Enemies charging this unit get -X total Impact rolls, unless this unit is Fatigued.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [],
      "id": "0bcGY4Xr4NE0",
      "name": "Brace",
    },
    {
      "coreType": 1,
      "description": "Follows same rules as heroes, picking one random spell to cast, and spending all tokens to cast it when activated. If the chosen spell can’t be cast for any reason, then the model doesn’t cast.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": null,
      "id": "47CAqf7ySlfc",
      "name": "Caster",
    },
    {
      "coreType": 1,
      "description": "May strike first with this weapon when charged, unless this unit is Fatigued.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [
        4,
        5,
        6,
      ],
      "id": "c45Fw0D2oGOk",
      "name": "Counter",
    },
    {
      "coreType": 1,
      "description": "Assign each wound to one model, and multiply it by X. Hits from Deadly must be resolved first, and these wounds don’t carry over to other models if the original target is killed.",
      "displayCoreRuleForSystem": false,
      "enabledGameSystems": [
        2,
